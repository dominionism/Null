#!/bin/sh
# `open`, as a bench run sees it. The agent is told to open an address in the
# person's Chrome with `open -g -a "Google Chrome" <address>`. In a bench run
# the person's Chrome is the bench's own, so the address goes there, in a new
# tab brought forward, as `open` does in a person's own Chrome. Nothing else is
# opened: no other app, no file. The real `open` is shut out of bench runs by
# the sandbox anyway.
pages="${NULL_BENCH_PAGES:-http://127.0.0.1:8790}"
address=""
app=""
while [ $# -gt 0 ]; do
  case "$1" in
    -a) app="$2"; shift 2 ;;
    -*) shift ;;
    *) address="$1"; shift ;;
  esac
done
case "$app" in
  ""|"Google Chrome"|"Google Chrome.app"|"/Applications/Google Chrome.app") ;;
  *) echo "open: in this run only a web address can be opened, in Chrome; not $app" >&2; exit 1 ;;
esac
case "$address" in
  http://*|https://*) ;;
  *) echo "open: in this run only a web address can be opened, in Chrome" >&2; exit 1 ;;
esac
exec /usr/bin/curl -fsS -o /dev/null -G --data-urlencode "url=$address" "$pages/__bench/open"
