#!/bin/sh
# Null, for people who do not build it. Fetch the Null that was built for a release, check
# it, sign it on this Mac, put it in /Applications, make it start at login, and start it.
# And take it away again.
#
#   null install          the newest release
#   null install 0.1.0    that release
#   null uninstall
#   null identity         only make the signing identity, if this Mac has none
#
# It needs nothing but macOS: no Rust, no developer tools, no Node. An Apple Silicon Mac with
# macOS 13 or later. From a clone it is Mini/Scripts/null; without one:
#
#   curl -fsSL https://raw.githubusercontent.com/dominionism/Null/main/Mini/Scripts/null | sh -s install
#
# Three switches are for trying it:
#   NULL_TRY_IN=<folder>     put the app there, not in /Applications, and leave the login
#                            item and any Null that is running alone. The app is then signed
#                            only if NULL_SIGNING is given too
#   NULL_SIGNING=<folder>    where the signing identity is kept and made, in place of
#                            ~/Library/Application Support/Null Signing
#   NULL_RELEASES=<address>  where releases are fetched from, in place of GitHub: a folder,
#                            as a file:// address, that holds null-v<version>/ with the files
set -eu

repo="dominionism/Null"
app="Null.app"
identifier="io.github.dominionism.null-mini"
agent="$HOME/Library/LaunchAgents/$identifier.plist"
releases="${NULL_RELEASES:-https://github.com/$repo/releases/download}"
try_in="${NULL_TRY_IN:-}"
work=""

# macOS ties the permissions it gives an app (Full Disk Access, its questions about folders)
# to who signed it. An app with no certificate is known only as the exact build, so every
# update starts the questions again. Signed with one certificate that stays on this Mac, the
# answers hold from one Null to the next. The certificate is made here, once, and kept in a
# keychain file of its own beside the password that opens it. macOS is never asked to trust
# it: it only has to be the same certificate each time.
identity="Null Local Signing"
signing="${NULL_SIGNING:-$HOME/Library/Application Support/Null Signing}"
keychain="$signing/signing.keychain-db"
newline='
'

# What the Oh-my-pi inside the app has to be: signed with a Developer ID that Apple issued,
# as its author publishes it. Null itself has no such certificate.
developer_id='anchor apple generic and certificate 1[field.1.2.840.113635.100.6.2.6] exists and certificate leaf[field.1.2.840.113635.100.6.1.13] exists'

fail() {
	echo "$1" >&2
	exit 1
}

cleanup() {
	[ -z "$work" ] || rm -rf "$work"
}

# Make the signing identity, if this Mac has none: a key and a ten-year certificate that can
# only sign code, in a keychain of their own. Nothing else on the Mac is changed, and nothing
# is asked of the person.
make_identity() {
	[ ! -f "$keychain" ] || return 0
	made=$(mktemp -d)
	cat > "$made/cert.cnf" <<CNF
[req]
distinguished_name = name
x509_extensions = extensions
prompt = no
[name]
CN = $identity
[extensions]
basicConstraints = critical, CA:false
keyUsage = critical, digitalSignature
extendedKeyUsage = critical, codeSigning
CNF
	password=$(/usr/bin/openssl rand -hex 24)
	if /usr/bin/openssl req -x509 -newkey rsa:2048 -nodes -days 3650 -config "$made/cert.cnf" -keyout "$made/key.pem" -out "$made/cert.pem" 2> /dev/null &&
		/usr/bin/openssl pkcs12 -export -inkey "$made/key.pem" -in "$made/cert.pem" -name "$identity" -out "$made/identity.p12" -passout "pass:$password" 2> /dev/null &&
		mkdir -p "$signing" && chmod 700 "$signing" &&
		(umask 077 && printf '%s' "$password" > "$signing/password") &&
		security create-keychain -p "$password" "$keychain" &&
		security set-keychain-settings "$keychain" &&
		security import "$made/identity.p12" -k "$keychain" -P "$password" -T /usr/bin/codesign > /dev/null 2>&1 &&
		security set-key-partition-list -S apple-tool:,apple: -s -k "$password" "$keychain" > /dev/null 2>&1 &&
		security lock-keychain "$keychain"; then
		rm -rf "$made"
		echo "Made a signing identity for Null on this Mac, in $signing."
		return 0
	fi
	rm -rf "$made"
	security delete-keychain "$keychain" 2> /dev/null || true
	rm -f "$signing/password"
	return 1
}

# Put the keychain search list back as it was, and lock the signing keychain.
restore_keychains() {
	old=$IFS
	IFS=$newline
	set -f
	# shellcheck disable=SC2086 # one keychain per line
	security list-keychains -d user -s $searched
	set +f
	IFS=$old
	security lock-keychain "$keychain" 2> /dev/null || true
}

# codesign only looks in keychains on the search list, so the signing keychain is on it while
# this runs and off it again afterwards, whatever happens.
sign() {
	searched=$(security list-keychains -d user | sed -e 's/^[[:space:]]*"//' -e 's/"[[:space:]]*$//')
	if [ -z "$searched" ]; then
		echo "The keychain search list is empty, so it could not be put back; not signing." >&2
		return 1
	fi
	trap 'restore_keychains; cleanup' EXIT
	old=$IFS
	IFS=$newline
	set -f
	# shellcheck disable=SC2086 # one keychain per line
	security list-keychains -d user -s $searched "$keychain"
	set +f
	IFS=$old
	signed=1
	if security unlock-keychain -p "$(cat "$signing/password")" "$keychain" 2> /dev/null &&
		codesign --force --sign "$identity" --keychain "$keychain" "$1" 2> /dev/null; then
		signed=0
	fi
	restore_keychains
	trap cleanup EXIT
	return $signed
}

# Sign the app with this Mac's own identity, making the identity first if there is none.
# An app that could not be signed is still whole, and is installed as it was fetched.
sign_here() {
	if make_identity && sign "$1" && codesign --verify --deep --strict "$1" 2> /dev/null; then
		echo "Signed on this Mac, so that macOS knows this Null again after an update."
		return 0
	fi
	codesign --verify --deep --strict "$1" 2> /dev/null || fail "The app was left in pieces by the signing, so it was not installed."
	echo "Null could not be signed on this Mac, so it is installed as it was fetched."
	echo "macOS will then ask again for what it was allowed, each time Null is updated."
}

# The newest release of Null. The repository may hold releases of other things, so the tag
# has to be one of Null's.
newest() {
	curl -fsSL "https://api.github.com/repos/$repo/releases?per_page=50" | sed -n 's/^ *"tag_name": "null-v\(.*\)",$/\1/p' | head -1
}

install() {
	[ "$(uname -s)" = "Darwin" ] || fail "Null is a macOS app."
	[ "$(uname -m)" = "arm64" ] || fail "This Null is built for Apple Silicon Macs; this Mac is $(uname -m)."
	system=$(sw_vers -productVersion)
	[ "${system%%.*}" -ge 13 ] || fail "Null needs macOS 13 or later; this Mac has $system."

	version="${1:-}"
	if [ -z "$version" ]; then
		[ -z "${NULL_RELEASES:-}" ] || fail "With NULL_RELEASES, say which version: null install 0.1.0"
		version=$(newest) || fail "Could not ask GitHub which Null is the newest. Say which one: null install 0.1.0"
		[ -n "$version" ] || fail "GitHub lists no release of Null."
	fi
	case "$version" in
	*[!0-9.]* | "") fail "\"$version\" is not a version. As in: null install 0.1.0" ;;
	esac

	name="Null-$version-macos-arm64"
	from="$releases/null-v$version"
	work=$(mktemp -d)
	trap cleanup EXIT

	# The checksum first: it is small, and without it there is no such release.
	curl -fsSL -o "$work/SHA256SUMS.txt" "$from/SHA256SUMS.txt" 2> /dev/null || fail "There is no Null $version to fetch at $from."
	echo "Fetching Null $version, about 100 MB."
	curl -fL --progress-bar -o "$work/$name.zip" "$from/$name.zip" || fail "Null $version could not be fetched from $from."

	# What was fetched has to be what was published, and what is inside has to be Null with
	# the Oh-my-pi its author published. Anything else is not kept.
	(cd "$work" && shasum -a 256 -c SHA256SUMS.txt > /dev/null 2>&1) || fail "What was fetched is not the Null $version that was published, so it was not kept."
	ditto -x -k "$work/$name.zip" "$work"
	[ -d "$work/$app" ] || fail "What was fetched holds no $app, so it was not kept."
	codesign --verify --deep --strict "$work/$app" 2> /dev/null || fail "The app that was fetched is not as it was sealed, so it was not kept."
	codesign -dv "$work/$app" 2>&1 | grep -q "^Identifier=$identifier\$" || fail "The app that was fetched is not Null, so it was not kept."
	codesign --verify --strict -R="$developer_id" "$work/$app/Contents/MacOS/omp" 2> /dev/null || fail "The Oh-my-pi inside the app does not carry its author's signature, so the app was not kept."

	if [ -n "$try_in" ]; then
		[ -z "${NULL_SIGNING:-}" ] || sign_here "$work/$app"
		mkdir -p "$try_in"
		rm -rf "$try_in/$app"
		ditto "$work/$app" "$try_in/$app"
		echo "Null $version is in $try_in. Nothing else on this Mac was changed."
		return
	fi

	sign_here "$work/$app"

	# Stop the copy that is running, if any, before replacing it.
	launchctl bootout "gui/$(id -u)" "$agent" 2> /dev/null || true
	pkill -x null-mini 2> /dev/null || true

	installed="/Applications/$app"
	rm -rf "$installed"
	ditto "$work/$app" "$installed"

	# Start at login.
	mkdir -p "$(dirname "$agent")"
	cat > "$agent" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>$identifier</string>
	<key>ProgramArguments</key>
	<array>
		<string>$installed/Contents/MacOS/null-mini</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
</dict>
</plist>
PLIST
	launchctl bootstrap "gui/$(id -u)" "$agent"

	echo "Installed Null $version in /Applications and started it. Control+Space opens the box."
	echo "If nothing happens, look in ~/Library/Logs/Null/mini.log."
}

# Stop Null, remove it from /Applications and stop it starting at login. Its settings, its
# logs and its signing identity are left in place, so that a Null installed later is known
# to macOS as the same one.
uninstall() {
	if [ -n "$try_in" ]; then
		rm -rf "$try_in/$app"
		echo "Null is removed from $try_in."
		return
	fi
	launchctl bootout "gui/$(id -u)" "$agent" 2> /dev/null || true
	pkill -x null-mini 2> /dev/null || true
	rm -f "$agent"
	rm -rf "/Applications/$app"
	echo "Null is removed. Settings stay in ~/Library/Application Support/$identifier."
}

case "${1:-}" in
install)
	shift
	install "$@"
	;;
uninstall) uninstall ;;
identity) make_identity || fail "A signing identity could not be made in $signing." ;;
*) fail "usage: null install [version] | null uninstall | null identity" ;;
esac
