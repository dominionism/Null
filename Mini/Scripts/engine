#!/bin/sh
# Bring the Oh-my-pi that Null carries into Mini/Engine/, where the build takes it from.
# Mini/Engine.toml names the version and the checksum of each file. Files that are
# already there and right are left alone, so this is safe to run before every build.
#
#   Mini/Scripts/engine
#
# Or move Null to another version of Oh-my-pi. That version is fetched and asked what
# Null depends on (the harness check, Mini/src/check.rs), beside the version Null carries
# now. Only when every question passes is Engine.toml written and the new program put
# in place. Otherwise nothing changes.
#
#   Mini/Scripts/engine --to 18.8.7
#   Mini/Scripts/engine --to newest    whichever release of Oh-my-pi is the newest
set -eu

here=$(cd "$(dirname "$0")/.." && pwd)
toml="$here/Engine.toml"
engine="$here/Engine"
releases="https://github.com/can1357/oh-my-pi/releases/download"

# What Engine.toml says for one name: the version, or a file's checksum. A second
# word names another copy of the file to read.
pinned() {
	sed -n "s/^\"\{0,1\}$1\"\{0,1\}[[:space:]]*=[[:space:]]*\"\([^\"]*\)\".*/\1/p" "${2:-$toml}" | head -n 1
}

checksum() {
	shasum -a 256 "$1" | cut -d ' ' -f 1
}

# Who signed a program: its Apple team.
signer() {
	codesign -dv --verbose=2 "$1" 2>&1 | sed -n 's/^TeamIdentifier=//p'
}

# Stop, leaving nothing behind of a version that was being tried.
give_up() {
	if [ -n "${trial:-}" ]; then
		rm -rf "$trial"
	fi
	exit 1
}

# Fetch one file of a release: the version, its name there, and where to put it.
download() {
	echo "Fetching $2 from Oh-my-pi $1"
	# shellcheck disable=SC2086 # one option per word
	if ! curl --fail --location --retry 3 $progress --output "$3" "$releases/v$1/$2"; then
		echo "Oh-my-pi $1 has no $2 to fetch." >&2
		give_up
	fi
}

# Fetch one file of the version Null carries, under the name the build wants, unless
# the right one is already there. The checksum it has to match is the one in
# Engine.toml, never one that was downloaded beside it.
fetch() {
	want=$(pinned "$1")
	if [ -z "$want" ]; then
		echo "$toml has no checksum for $1." >&2
		exit 1
	fi
	if [ -f "$engine/$2" ] && [ "$(checksum "$engine/$2")" = "$want" ]; then
		return
	fi
	download "$version" "$1" "$engine/$2.part"
	got=$(checksum "$engine/$2.part")
	if [ "$got" != "$want" ]; then
		rm -f "$engine/$2.part"
		echo "$1 is not the file Null chose, so it was not kept." >&2
		echo "  checksum in Engine.toml: $want" >&2
		echo "  checksum of the download: $got" >&2
		exit 1
	fi
	mv "$engine/$2.part" "$engine/$2"
}

# Write one line of Engine.toml again: a name, and the value it has now.
rewrite() {
	sed "s/^\(\"\{0,1\}$1\"\{0,1\} = \)\"[^\"]*\"/\1\"$2\"/" "$toml.next" > "$toml.line"
	mv "$toml.line" "$toml.next"
}

# Try another version, and move Null to it only if it passes the harness check.
move_to() {
	next=${1#v}
	if [ "$next" = "newest" ]; then
		# The page of the newest release sends on to that release, whose address ends in its
		# name. Asked this way, GitHub sets no limit on how often, as it does for its API.
		next=$(curl --fail --silent --show-error --location --head --output /dev/null --write-out '%{url_effective}' "https://github.com/can1357/oh-my-pi/releases/latest" | sed -n 's#^.*/releases/tag/v\{0,1\}\(.*\)$#\1#p')
		if [ -z "$next" ]; then
			echo "Could not ask GitHub which Oh-my-pi is the newest." >&2
			exit 1
		fi
		echo "The newest Oh-my-pi is $next."
	fi
	if [ "$next" = "$version" ]; then
		echo "Null already carries Oh-my-pi $version."
		return
	fi
	trial="$engine/Trial"
	rm -rf "$trial"
	mkdir -p "$trial"
	for name in SHA256SUMS.txt LICENSE THIRD-PARTY-NOTICES.txt "$published"; do
		download "$next" "$name" "$trial/$name"
	done
	# A download that is not the file its own release lists is never run.
	for name in LICENSE THIRD-PARTY-NOTICES.txt "$published"; do
		listed=$(sed -n "s/^\([0-9a-f]\{64\}\)[[:space:]]\{1,\}$name\$/\1/p" "$trial/SHA256SUMS.txt")
		if [ "$listed" != "$(checksum "$trial/$name")" ]; then
			echo "$name is not the file the release of Oh-my-pi $next lists, so that version was not tried." >&2
			give_up
		fi
	done
	# Nor is one that is not signed by whoever signed the program Null carries now.
	if ! codesign --verify --strict "$trial/$published" 2> /dev/null || [ "$(signer "$trial/$published")" != "$(signer "$engine/$program")" ]; then
		echo "Oh-my-pi $next is not signed by whoever signed $version, so that version was not tried." >&2
		give_up
	fi
	chmod +x "$trial/$published"

	echo "Asking Oh-my-pi $next what Null depends on"
	# Null's own live checks only: the key check beside them opens the app, and asks nothing of Oh-my-pi's version.
	if ! (cd "$here" && NULL_MINI_ENGINE="$trial/$published" cargo test --bin null-mini -- --ignored); then
		echo "Oh-my-pi $next did not pass the harness check, so Null stays on $version." >&2
		echo "The version that was tried is in $trial." >&2
		exit 1
	fi

	cp "$toml" "$toml.next"
	rewrite version "$next"
	# The Null that just passed the check with it is the oldest one /update may offer it to.
	rewrite null "$(sed -n 's/^version = "\(.*\)"/\1/p' "$here/Cargo.toml" | head -n 1)"
	for name in LICENSE THIRD-PARTY-NOTICES.txt "$published"; do
		rewrite "$name" "$(checksum "$trial/$name")"
		if [ "$(pinned "$name" "$toml.next")" != "$(checksum "$trial/$name")" ]; then
			rm -f "$toml.next"
			echo "$toml has no line for $name to write the new checksum on, so nothing was changed." >&2
			exit 1
		fi
	done
	mv "$toml.next" "$toml"
	mv "$trial/$published" "$engine/$program"
	mv "$trial/LICENSE" "$trial/THIRD-PARTY-NOTICES.txt" "$engine/"
	rm -rf "$trial"
	echo "Null now carries Oh-my-pi $next: Engine.toml names it. Build and install to use it."
}

case "${1:-}" in
"") ;;
--to)
	if [ -z "${2:-}" ]; then
		echo "--to needs a version, as in: Mini/Scripts/engine --to 18.8.7" >&2
		exit 1
	fi
	;;
*)
	echo "usage: Mini/Scripts/engine [--to <version>]" >&2
	exit 1
	;;
esac

version=$(pinned version)
if [ -z "$version" ]; then
	echo "$toml names no version." >&2
	exit 1
fi

# Oh-my-pi's name for this Mac's program, and the name the build looks for: Tauri wants
# a program it takes into the app to end in Rust's name for the kind of Mac.
case "$(uname -s) $(uname -m)" in
"Darwin arm64")
	published="omp-darwin-arm64"
	program="omp-aarch64-apple-darwin"
	;;
*)
	echo "Null carries Oh-my-pi for Apple Silicon Macs only, for now." >&2
	exit 1
	;;
esac

# A bar for a person watching, nothing but errors otherwise.
if [ -t 2 ]; then
	progress="--progress-bar"
else
	progress="--silent --show-error"
fi

mkdir -p "$engine"
fetch "$published" "$program"
chmod +x "$engine/$program"
fetch LICENSE LICENSE
fetch THIRD-PARTY-NOTICES.txt THIRD-PARTY-NOTICES.txt

if [ "${1:-}" = "--to" ]; then
	move_to "$2"
else
	echo "Oh-my-pi $version is in $engine."
fi
